# =============================================================================
# Enterprise Knowledge Transfer Agent - Environment Configuration
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
APP_NAME=Knowledge Transfer Agent
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector Store (FAISS)
# -----------------------------------------------------------------------------
VECTOR_STORE_PATH=./data/faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Retrieval
# Approximate chunks to LLM = TOP_K_SEMANTIC + TOP_K_KEYWORD (after dedup).
# Raise SEMANTIC for recall; lower KEYWORD if answers feel noisy / off-topic (MMR diversity).
# -----------------------------------------------------------------------------
TOP_K_SEMANTIC=6
TOP_K_KEYWORD=2
RETRIEVAL_SCORE_THRESHOLD=0.7

# Cross-encoder rerank after hybrid retrieval (requires: pip install flashrank)
RERANK_ENABLED=false
RERANK_TOP_N=5
# Smaller/faster: ms-marco-TinyBERT-L-2-v2 — stronger: ms-marco-MiniLM-L-12-v2
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# -----------------------------------------------------------------------------
# Agent Confidence
# -----------------------------------------------------------------------------
CONFIDENCE_VALID=0.9
CONFIDENCE_INVALID=0.2
CONFIDENCE_NO_DOCS=0.0
CONFIDENCE_PENALTY_PER_ISSUE=0.1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
ENABLE_RBAC=false

# -----------------------------------------------------------------------------
# Optional: Confluence (REST API — not web scraping)
# -----------------------------------------------------------------------------
# Base URL (often ends with /wiki for Atlassian Cloud)
# CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
# API token (Atlassian Cloud: https://id.atlassian.com/manage-profile/security/api-tokens)
# CONFLUENCE_TOKEN=...
# If token-only login fails, set your Atlassian account email:
# CONFLUENCE_USERNAME=you@company.com
# Comma-separated space keys
# CONFLUENCE_SPACE_KEYS=ENG,DOCS
# CONFLUENCE_CLOUD=true
# Pagination batch size (max 250 per Confluence REST limits)
# CONFLUENCE_PAGE_BATCH_SIZE=100
# Optional delay seconds between pagination calls (rate limits)
# CONFLUENCE_REQUEST_DELAY_SECONDS=0

# -----------------------------------------------------------------------------
# Optional: Git repositories (comma-separated)
# Each entry may be:
#   - Local path: /path/to/clone
#   - Remote URL: https://github.com/org/repo.git (requires git installed; shallow clone to GITHUB_CLONE_CACHE_DIR)
# For private GitHub HTTPS repos, set GITHUB_TOKEN (PAT).
# -----------------------------------------------------------------------------
# GITHUB_REPOS=https://github.com/org/public-repo.git,/path/to/local/clone
# GITHUB_TOKEN=ghp_...
# GITHUB_CLONE_CACHE_DIR=./data/git_clones
# GITHUB_SHALLOW_CLONE=true
# GITHUB_CLONE_BRANCH=main
# GITHUB_CLONE_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM Retry
# -----------------------------------------------------------------------------
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# Rate Limiting (requests per period)
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# -----------------------------------------------------------------------------
# Agentic orchestration
# -----------------------------------------------------------------------------
MAX_HOPS=3
MAX_REFLECTION_RETRIES=1

# -----------------------------------------------------------------------------
# Guardrails (input/output safety)
# -----------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_PROMPT_INJECTION=true
GUARDRAILS_REDACT_PII=true
GUARDRAILS_CHECK_OUTPUT=true
GUARDRAILS_MAX_QUESTION_CHARS=2000
GUARDRAILS_BLOCK_KEYWORDS=true
# External policy pack (injection regex, keyword deny-list, PII patterns).
GUARDRAILS_RULES_PATH=config/guardrails_rules.json
# Optional runtime override of keywords only (comma-separated). Empty = use policy file.
# GUARDRAILS_BLOCKED_KEYWORDS=exfiltrate,ransomware,dump all passwords
GUARDRAILS_BLOCKED_KEYWORDS=

# -----------------------------------------------------------------------------
# Shared long-term memory (workspace-scoped)
# -----------------------------------------------------------------------------
SHARED_MEMORY_ENABLED=true
SHARED_MEMORY_WRITE_ENABLED=true
SHARED_MEMORY_MAX_ITEMS=8
SHARED_MEMORY_MAX_STORE=200
SHARED_MEMORY_MIN_CONFIDENCE=0.5

# -----------------------------------------------------------------------------
# Monitoring / Prometheus
# -----------------------------------------------------------------------------
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Web UI (optional overrides in browser Settings)
# -----------------------------------------------------------------------------
# API_BASE_URL=http://127.0.0.1:8000
# API_KEY=your-api-key-if-rbac-enabled
